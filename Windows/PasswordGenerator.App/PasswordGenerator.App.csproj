<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PasswordGenerator</AssemblyName>
    <RootNamespace>PasswordGenerator.App</RootNamespace>
    <Version>2.3.6</Version>
    <AssemblyVersion>2.3.6.0</AssemblyVersion>
    <ApplicationIcon>Assets\PasswordGenerator.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PasswordGenerator.Core\PasswordGenerator.Core.csproj" />
    <ProjectReference Include="..\PasswordGenerator.Security\PasswordGenerator.Security.csproj" />
    <Resource Include="..\..\Assets\PasswordGeneratorLogo.png" Link="Assets\PasswordGeneratorLogo.png" />
    <Resource Include="Assets\PasswordGenerator.ico" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="Notices\THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Licenses\python-mnemonic-MIT.txt" Link="Notices\python-mnemonic-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
