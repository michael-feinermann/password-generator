<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PasswordGenerator.DesignPreview</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PasswordGenerator.Core\PasswordGenerator.Core.csproj" />
    <Compile Include="..\PasswordGenerator.App\MainWindow.cs" Link="MainWindow.cs" />
    <Resource Include="..\..\Assets\PasswordGeneratorLogo.png" Link="Assets\PasswordGeneratorLogo.png" />
    <Resource Include="..\PasswordGenerator.App\Assets\PasswordGenerator.ico" Link="Assets\PasswordGenerator.ico" />
    <Page Include="..\PasswordGenerator.App\Themes\Controls.xaml" Link="Themes\Controls.xaml" />
  </ItemGroup>
</Project>
